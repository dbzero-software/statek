# Statek local development environment
# Used by scripts/run_ui_local.sh

# ── db0 storage ───────────────────────────────────────────────────────────────
DBZERO_ROOT=/selltime_data/
STATEK_ORG_NAME=Selltime
STATEK_PROJECT_NAME=selltime
STATEK_ENV=dev

# ── Web UI ────────────────────────────────────────────────────────────────────
STATEK_UI_HOST=0.0.0.0
STATEK_UI_PORT=8888

# Colon-separated list of project root directories to add to sys.path so that
# db0 can resolve callables from external projects stored in the database.
# Example: STATEK_EXTERNAL_PATHS=/src/selltime:/src/other_project
STATEK_EXTERNAL_PATHS=/src/selltime

# ── LLM API (OpenRouter) ──────────────────────────────────────────────────────
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o

# ── Statek harness settings ───────────────────────────────────────────────────
STATEK_PROMPT_FILES_DIR=
STATEK_EXAMPLES_DIR=
STATEK_MAX_TURNS=8
STATEK_MAX_EXCEPTIONS=3
STATEK_MAX_CONSECUTIVE_EXCEPTIONS=2
STATEK_MAX_TOKEN_USAGE=50000
STATEK_CHAT_STYLE=MARKDOWN
STATEK_EXAMPLES_STYLE=CONSOLE
STATEK_XML_BOX_CONSOLE=CONSOLE_OUTPUT
STATEK_LOG_LEVEL=DEBUG
